Screens:
  Modern Validation System:
    Properties:
      Fill: = RGBA(245, 245, 245, 1)
      LoadingSpinnerColor: = RGBA(56, 96, 178, 1)
      OnVisible: = Set(varTicketCreatedDate, Now())
    Children:
      # Modern Header
      - HeaderContainer:
          Control: Container@1.3.0
          Properties:
            Fill: = RGBA(255, 255, 255, 1)
            Height: = 80
            Width: = Parent.Width
            DropShadow: = DropShadow.Light
            BorderRadius: = 8
            X: = 0
            Y: = 0
          Children:
            - AppTitle:
                Control: Text@0.0.51
                Properties:
                    Text: = "Unified Validation System"
                  FontSize: = 24
                  FontWeight: = FontWeight.Bold
                  Color: = RGBA(50, 49, 48, 1)
                  Height: = 40
                  Width: = 400
                  X: = 24
                  Y: = 20
            - UserInfo:
                Control: Text@0.0.51
                Properties:
                  Text: = "Welcome, " & User().FullName
                  FontSize: = 14
                  Color: = RGBA(96, 94, 92, 1)
                  Height: = 20
                  Width: = 300
                  X: = Parent.Width - 324
                  Y: = 30

      # Main Content Container
      - MainContentContainer:
          Control: Container@1.3.0
          Properties:
            Fill: = RGBA(255, 255, 255, 1)
            Height: = Parent.Height - 100
            Width: = Parent.Width - 40
            DropShadow: = DropShadow.Light
            BorderRadius: = 12
            X: = 20
            Y: = 90
          Children:

            # Left Panel - Form Inputs
            - LeftPanel:
                Control: Container@1.3.0
                Properties:
                  Fill: = RGBA(255, 255, 255, 1)
                  Height: = Parent.Height - 20
                  Width: = (Parent.Width / 2) - 30
              
